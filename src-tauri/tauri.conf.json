{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iTerm",
  "version": "0.7.0",
  "identifier": "com.oubliele.iterm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "iTerm",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Desktop serial, SSH, and ADB terminal",
    "longDescription": "A fast, local-first serial, SSH, and ADB terminal for development and device debugging."
  }
}
